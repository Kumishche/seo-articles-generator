# Адрес Spring Boot backend для прокси /api/* (rewrites в next.config.ts).
# Читается при сборке и запуске dev-сервера.
BACKEND_URL=http://localhost:8080

# Домен сайта для предпросмотра сниппета в редакторе
NEXT_PUBLIC_SITE_DOMAIN=example.ru

# Только если нужно обращаться к backend напрямую, минуя прокси Next.js
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
