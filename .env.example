# Скопируйте в .env и заполните. Файл .env не коммитится.

# Обязательно: ключ OpenAI
OPENAI_API_KEY=

# Необязательно
OPENAI_MODEL=gpt-5-mini
# OPENAI_SEARCH_MODEL=gpt-5-mini
# Адрес API, если запросы к OpenAI идут через прокси-шлюз
# OPENAI_BASE_URL=https://api.openai.com/v1

# Домен сайта для предпросмотра сниппета в редакторе (подставляется при сборке фронтенда)
SITE_DOMAIN=example.ru
